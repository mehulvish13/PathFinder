# PathFinder backend environment — copy to backend/.env and fill in real values.
# NEVER commit backend/.env. GEMINI_API_KEY is required for AI features.

# Local dev default is SQLite; leave unset to use backend/pathfinder.db.
# Production (Render): set to your Neon PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Required for AI profile extraction, AI Tutor and AI Explain.
GEMINI_API_KEY=

# Optional comma-separated extra CORS origins (production frontend origin).
# Localhost origins are always allowed by default.
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=
